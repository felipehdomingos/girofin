# Local SQLite. Never commit the database or production secrets.
FINANCEIRO_DB=./data/financeiro.db

# Autentica??o e PostgreSQL
DATABASE_URL=
# Minimo de 32 caracteres. A aplicacao recusa subir sem isso.
AUTH_SECRET=
APP_URL=http://localhost:3000
APP_ENV=local
DATABASE_POOL_MAX=5
DATABASE_SSL=false
# CA que valida o certificado do Postgres. No Azure, a DigiCert Global Root G2.
# Sem ela a validacao continua ligada e usa a store padrao do Node.
# DATABASE_CA_CERT=


# E-mails transacionais via Resend
EMAIL_FROM_NO_REPLY=GiroFin <no-reply@girofin.com.br>
SUPPORT_EMAIL=suporte@girofin.com.br
RESEND_API_KEY=

# Somente desenvolvimento local de usuário único; nunca habilitar no deploy.
ALLOW_UNSCOPED_FINANCEIRO_DB=false

# Use APP_ENV=staging ou APP_ENV=production no deploy Azure.
