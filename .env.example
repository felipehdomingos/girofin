# PostgreSQL. Never commit production secrets.
DATABASE_URL=
# Minimo de 32 caracteres. A aplicacao recusa subir sem isso.
AUTH_SECRET=
APP_URL=http://localhost:3000
APP_ENV=local
DATABASE_POOL_MAX=5
DATABASE_SSL=false
# CA que valida o certificado do Postgres. No Azure, a DigiCert Global Root G2.
# Sem ela a validacao continua ligada e usa a store padrao do Node.
# DATABASE_CA_CERT=


# Login com Google (OAuth). Sem as duas primeiras, /api/v1/auth/google/callback
# responde google_unavailable. GOOGLE_REDIRECT_URI e opcional: sem ela o callback
# usa a origem da propria requisicao, o que quebra atras de proxy que reescreve
# o host. No console do Google, a URI autorizada e:
# https://SEU-DOMINIO/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# E-mails transacionais via Resend
EMAIL_FROM_NO_REPLY=GiroFin <no-reply@girofin.com.br>
SUPPORT_EMAIL=suporte@girofin.com.br
RESEND_API_KEY=

# Somente desenvolvimento local de usuário único; nunca habilitar no deploy.

# Use APP_ENV=staging ou APP_ENV=production no deploy Azure.
